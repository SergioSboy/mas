# Native Python: PostgreSQL installed directly on your computer.
# Docker Compose overrides DATABASE_URL with its internal db:5432 address.
DATABASE_URL=postgresql://salesbench_reader:demo_reader@127.0.0.1:5432/salesbench
# Used only by init_db.py and local integration tests, never by the agents.
DATABASE_ADMIN_URL=postgresql://salesbench_owner:demo_owner@127.0.0.1:5432/salesbench

# Only needed for --backend live (works in both Docker and native Python).
OPENAI_API_KEY=
LLM_MODEL=
LLM_ENDPOINT=https://api.openai.com/v1
